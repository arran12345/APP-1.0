---
// Hero — split layout, 55/45 on desktop, stacks on mobile.
---
<section class="hero" id="top">
  <div class="hero__inner container">
    <div class="hero__content">
      <p class="eyebrow">HANDCRAFTED · REWORKED · RESTORED</p>
      <h1 class="h1 hero__title">
        Old furniture, <span class="accent">new stories.</span>
      </h1>
      <p class="hero__subhead">
        We rescue forgotten furniture and rework each piece by hand — modern
        farmhouse character with the soul of something well-made.
      </p>
      <div class="hero__ctas">
        <a class="btn btn-primary" href="#pieces">View Pieces</a>
        <a class="btn btn-secondary" href="/?type=commission#contact">Commission a Piece</a>
      </div>
    </div>

    <div class="hero__image">
      <img src="/images/hero.svg" alt="A tall, glass-fronted Weston cabinet in olive" width="800" height="1000" />
      <span class="hero__label label">PIECE No. 005</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    width: 100%;
  }
  .hero__content { max-width: 36rem; }
  .hero .eyebrow { margin-bottom: 1.75rem; }
  .hero__title { margin-bottom: 1.75rem; }
  .hero__subhead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgba(46, 46, 46, 0.78);
    max-width: 30rem;
    margin-bottom: 2.5rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__label {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    color: var(--charcoal);
    background: var(--cream);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hairline);
  }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero { min-height: 0; padding-top: 3rem; padding-bottom: 4rem; }
    .hero__image { max-height: 70vh; }
  }
</style>
